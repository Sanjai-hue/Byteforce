# ReqGuard AI — backend environment
# Copy to backend/.env and fill in. Never commit the filled file.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated allowed origins. In production set your real Vercel domain.
# Do not use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- InsForge (database + storage) -----------------------------------------
# Server-side only. The api_key is an admin key: never expose it to the frontend.
INSFORGE_URL=https://your-app.us-east.insforge.app
INSFORGE_API_KEY=ik_your_admin_api_key
INSFORGE_STORAGE_BUCKET=reqguard-documents
STORAGE_ENABLED=true

# --- LLM -------------------------------------------------------------------
# "groq" (default) or "openrouter".
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Verified end to end (49/49 live checks). openai/gpt-oss-120b is larger but has
# not completed a full run within the free quota. List what your key can use:
# GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
# Hidden reasoning is most of each call's tokens. "low" cut a real ambiguity call
# by 27% with identical findings. Empty = provider default. gpt-oss models accept
# low/medium/high; qwen models accept none/default.
GROQ_REASONING_EFFORT=low
# Free-tier keys allow 8K tokens/minute: a 429 is waited out for up to this many
# seconds per call. A daily quota asks for longer and fails fast with a clear error.
LLM_RATE_LIMIT_WAIT_SECONDS=180

# Only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Candidate-pair thresholds, chosen by measuring the sample's similarity
# distribution. A contradiction threshold of 0.55 selected ~89% of all pairs and
# the cap then dropped real conflicts, so keep these two in step.
DUPLICATE_SIMILARITY_THRESHOLD=0.82
CONTRADICTION_SIMILARITY_THRESHOLD=0.70
MAX_CANDIDATE_PAIRS=300

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_REQUIREMENTS=400
EXTRACTION_CHUNK_CHARS=9000
